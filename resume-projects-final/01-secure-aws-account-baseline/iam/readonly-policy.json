{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadOnlyAccess",
      "Effect": "Allow",
      "Action": [
        "ec2:Describe*",
        "s3:Get*",
        "s3:List*",
        "iam:List*",
        "iam:Get*",
        "cloudtrail:DescribeTrails",
        "cloudtrail:GetTrailStatus",
        "logs:Describe*",
        "logs:Get*",
        "config:Describe*",
        "config:Get*",
        "organizations:Describe*"
      ],
      "Resource": "*"
    }
  ]
}